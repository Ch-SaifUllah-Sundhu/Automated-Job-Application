# Copy this file to .env and fill in your real values
# cp .env.example .env

# ── Supabase ──────────────────────────────────────────────────
# Get from: https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
# Service role key: bypasses RLS (needed for background agent job inserts)
# Get from: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── Supabase (Next.js frontend) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Groq (Llama 3) ────────────────────────────────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
